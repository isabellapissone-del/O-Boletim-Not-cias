# MOÇAMBIQUE AGORA - Configurações

# Supabase
# Obtidas no painel do Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Chave secreta do Supabase (USAR APENAS NO SERVIDOR)
# Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gemini AI (USAR APENAS NO SERVIDOR)
# AI Studio -> Secrets
GEMINI_API_KEY="your-gemini-key"

# SEO & Analytics
NEXT_PUBLIC_SITE_URL="https://mocambique-agora.vercel.app"
GOOGLE_SITE_VERIFICATION="your-verification-code"
GA_MEASUREMENT_ID="G-XXXXXXXXXX"
